{
  "version": 2,
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/index.py?route=health"
    },
    {
      "source": "/api/daily",
      "destination": "/api/index.py?route=daily"
    },
    {
      "source": "/api/telegram",
      "destination": "/api/index.py?route=telegram"
    },
    {
      "source": "/api/strava/callback",
      "destination": "/api/index.py?route=strava_callback"
    }
  ],
  "crons": [
    {
      "path": "/api/daily",
      "schedule": "0 0 * * *"
    }
  ]
}
